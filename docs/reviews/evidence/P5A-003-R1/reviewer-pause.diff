+
+    [STATestMethod]
+    public void Reviewer_PauseMustCancelPendingPerchPickBeforeResume()
+    {
+        var w = new MainWindow();
+        try
+        {
+            w.TestGetElapsedMs = () => 5000;
+            w.StartPerchPick();
+            Assert.IsTrue(w.IsPerchPickActive);
+            w.PauseAnimation();
+            Assert.IsFalse(w.IsPerchPickActive,
+                "Pause stops the timer, so it must cancel a pending pick synchronously.");
+        }
+        finally { w.Close(); }
+    }}
