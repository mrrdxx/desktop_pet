<Window x:Class="DesktopPet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopPet"
        Width="120"
        Height="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        SourceInitialized="MainWindow_SourceInitialized">
    <Canvas x:Name="PetCanvas"
            Width="120"
            Height="120"
            Background="Transparent"
            MouseLeftButtonDown="PetCanvas_MouseLeftButtonDown"
            MouseLeftButtonUp="PetCanvas_MouseLeftButtonUp"
            MouseMove="PetCanvas_MouseMove"
            LostMouseCapture="PetCanvas_LostMouseCapture">
        <Image x:Name="PetImage"
               Width="120"
               Height="120"
               Stretch="None">
            <Image.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="FrameOffsetTransform" X="0" Y="0" />
                    <!-- P5B-003 S2：攀爬朝向镜像。素材默认朝左伸爪；
                         目标方向在宠物右侧时 ScaleX=-1 翻转到朝右。
                         中心=素材脚点 footAnchor(60,110)，y 不变故脚点稳定。
                         位置在 FrameOffset 之后、Wobble 之前：镜像不影响偏移与晃动。 -->
                    <ScaleTransform x:Name="ClimbMirrorTransform" ScaleX="1" CenterX="60" CenterY="110" />
                    <!-- P5A-002：栖息跟随成功后的短暂晃动（纯视觉）。
                         R1-1：旋转中心=帧偏移补偿后的素材脚点
                         （footAnchor + FrameOffset，代码每 tick 更新），
                         晃动时素材脚点保持不动、仍贴住目标窗口上沿；
                         不改宠物窗口位置。XAML 初值仅为占位。 -->
                    <RotateTransform x:Name="WobbleTransform" Angle="0" CenterX="60" CenterY="110" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <!-- P3-001 F-08 R14: Lightweight personality badge overlay for visual
             identification. Program-drawn shapes, no new art assets.
             IsHitTestVisible=False so the badge never intercepts mouse input. -->
        <Canvas x:Name="BadgeCanvas"
                Width="120"
                Height="120"
                IsHitTestVisible="False" />
    </Canvas>
</Window>
